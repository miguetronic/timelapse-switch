# SPDX-License-Identifier: GPL-2.0-or-later
#
# Git commit-msg hook: rejects a commit whose first line does not follow
# Conventional Commits, or whose message holds a word of the maintainer's
# private list (tools/check-private-words.sh). Enable it once per clone:
#
#   git config core.hooksPath tools/git-hooks
#
# tools/check.sh also runs it on every commit of the history.
#
#   Accepted:  feat: add x16 speed
#              fix(audio): keep sync after many switches
#              feat!: new settings format     ("!" marks a breaking change)
#   Rejected:  "added x16 speed", "Fix: ...", "feat:add" (no space),
#              first lines longer than 72 characters
#
# Arguments:
#   Path of the file that holds the commit message (given by Git).

set -u

readonly TYPES='feat|fix|perf|docs|test|build|ci|refactor|style|chore|revert'
readonly PATTERN="^(${TYPES})(\([a-z0-9-]+\))?!?: [^ ].*$"
# Messages Git writes itself: merges, reverts, and fixups that are squashed
# before they reach main.
readonly GIT_MESSAGES='^(Merge |Revert "|fixup! |squash! )'
readonly MAX_LENGTH=72

# Prints a message to stderr.
err() {
  echo "$*" >&2
}

main() {
  local subject
  subject="$(head -n 1 "$1")"
  if [[ "${subject}" =~ ${GIT_MESSAGES} ]]; then
    return 0
  fi
  if [[ ! "${subject}" =~ ${PATTERN} ]]; then
    err 'Commit message does not follow Conventional Commits:'
    err "  ${subject}"
    err 'Expected: <type>(<optional scope>)<optional !>: <description>'
    err "Types: ${TYPES//|/, }."
    err 'Example: feat: add x16 speed. See CONTRIBUTING.md.'
    return 1
  fi
  if ((${#subject} > MAX_LENGTH)); then
    err "First line has ${#subject} characters; keep it to ${MAX_LENGTH}:"
    err "  ${subject}"
    return 1
  fi
  # No word of the maintainer's private list, in the whole message.
  "$(git rev-parse --show-toplevel)/tools/check-private-words.sh" \
    --message "$1" >/dev/null || return 1
}

main "$@"
