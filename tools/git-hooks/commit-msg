#
# commit-msg: reject a commit whose first line does not follow Conventional Commits.
#
# Git runs it before every commit once hooks are enabled (once per clone):
#   git config core.hooksPath tools/git-hooks
# tools/check.sh also runs it on every commit in the history.
#
#   Accepted:  feat: add x16 speed
#              fix(audio): keep sync after many switches
#              feat!: new settings format          ("!" marks a breaking change)
#   Rejected:  "added x16 speed", "Fix: ...", "feat:add" (no space), subjects over 72 characters

set -u

TYPES='feat|fix|perf|docs|test|build|ci|refactor|style|chore|revert'
PATTERN="^($TYPES)(\([a-z0-9-]+\))?!?: [^ ].*$"
MAX_LENGTH=72

subject=$(head -n 1 "$1")

# Messages Git writes itself: merges, and fixups that will be squashed before reaching main.
if [[ $subject =~ ^(Merge |Revert \"|fixup! |squash! ) ]]; then
	exit 0
fi

if [[ ! $subject =~ $PATTERN ]]; then
	echo "Commit message does not follow Conventional Commits:"
	echo "  $subject"
	echo "Expected: <type>(<optional scope>)<optional !>: <description>"
	echo "Types: ${TYPES//|/, }. Example: feat: add x16 speed. See CONTRIBUTING.md."
	exit 1
fi

if ((${#subject} > MAX_LENGTH)); then
	echo "First line is ${#subject} characters; keep it at $MAX_LENGTH or less:"
	echo "  $subject"
	exit 1
fi
