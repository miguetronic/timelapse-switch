# Git pre-commit hook: refuses a commit whose staged files hold a word of
# the maintainer's private list (tools/check-private-words.sh). Enabled
# with the other hooks:
#
#   git config core.hooksPath tools/git-hooks

exec "$(git rev-parse --show-toplevel)/tools/check-private-words.sh" --staged
